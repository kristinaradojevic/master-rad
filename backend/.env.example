# Copy to .env and fill in the keys for the providers you want to use.
# A provider whose key is missing simply won't appear in /api/models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Set once `mlx_lm.server` is running the locally fine-tuned model (see
# README's Fine-tuning section) — makes it selectable in /api/models.
# Typically: http://localhost:8081/v1
LOCAL_MLX_BASE_URL=
# Optional — only needed if mlx_lm.server was started with a --model path
# other than the default ml/data/finetune/fused_model (relative to the
# repo root). Must match exactly, or the server rejects every request.
LOCAL_MLX_MODEL=
