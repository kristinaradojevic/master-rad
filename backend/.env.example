# Copy to .env and fill in the keys for the providers you want to use.
# A provider whose key is missing simply won't appear in /api/models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Set after running ml/preprocess/run_finetune_job.py successfully — makes
# the fine-tuned model selectable in /api/models. See README's Fine-tuning section.
FINETUNED_MODEL_ID=
